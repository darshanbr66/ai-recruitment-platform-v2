DATABASE_URL=postgresql+psycopg://ai_recruitment:changeme@localhost:5432/ai_recruitment

ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=changeme
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

CORS_ALLOW_ORIGINS=["http://localhost:5173"]

# Local resume storage (backend/uploads/resumes by default).
RESUME_STORAGE_DIR=uploads/resumes
MAX_RESUME_SIZE_MB=10

# Optional: outbound email (application confirmations, status updates,
# assessment invitations). Without these, the app runs fully — sends are
# logged as "not configured" rather than faked. Get a key at
# https://resend.com; EMAIL_FROM must be a verified sender/domain there.
RESEND_API_KEY=
EMAIL_FROM=

# Optional: AI-assisted resume screening. Without any of these set,
# screening returns a clear "provider not configured" error rather than a
# fabricated result. Prefer the free/local Ollama option below — set
# ONLY ONE of the three; Ollama wins if set, then Anthropic, then OpenAI.

# Free, local, no API key — install Ollama (https://ollama.com), run
# `ollama pull llama3.1` (or another model), then set this to its URL.
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.1

# Paid, cloud-hosted alternatives — only needed if you don't want to run
# Ollama locally.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
