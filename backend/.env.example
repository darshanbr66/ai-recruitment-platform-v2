# Local dev: postgresql+psycopg://user:pass@localhost:5432/dbname
# Render Postgres: take the "External Database URL" Render shows you and
# change its scheme from postgres:// (or postgresql://) to
# postgresql+psycopg:// — SQLAlchemy's async psycopg3 driver requires the
# explicit +psycopg suffix; Render's own connection string does not include
# it. See docs/deployment.md.
DATABASE_URL=postgresql+psycopg://ai_recruitment:changeme@localhost:5432/ai_recruitment

ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# Production: set a freshly generated value in the Render dashboard —
# never reuse the local dev value, never commit the real value anywhere.
JWT_SECRET_KEY=changeme
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# JSON array of allowed origins (pydantic parses this as JSON, not a plain
# comma list). Production: the deployed Vercel domain(s), e.g.
# ["https://sigvitas.vercel.app"]. Never use ["*"] once cookies/auth are
# involved (allow_credentials=True is incompatible with a wildcard origin
# anyway per the CORS spec).
CORS_ALLOW_ORIGINS=["http://localhost:5173"]

# The candidate-facing frontend's own origin — used to build assessment
# invitation / campus-drive links that a recruiter shares. Production: the
# same Vercel domain as above.
FRONTEND_BASE_URL=http://localhost:5173

# Resume FILE BYTES storage backend — "local" (disk, dev default) or
# "mongodb_gridfs" (production; see docs/deployment.md § 11). This is
# independent of DATABASE_URL: candidate/application/resume *metadata*
# always lives in Postgres (CLAUDE.md § 2) — only the raw file bytes move.
RESUME_STORAGE_PROVIDER=local

# Local-disk resume storage (backend/uploads/resumes by default). Only
# used when RESUME_STORAGE_PROVIDER=local. PRODUCTION WARNING: Render's
# default web-service filesystem is ephemeral — anything written here is
# lost on every deploy/restart and is not shared across instances. Set
# RESUME_STORAGE_PROVIDER=mongodb_gridfs in production instead (below).
RESUME_STORAGE_DIR=uploads/resumes
MAX_RESUME_SIZE_MB=10

# MongoDB — only used for RESUME_STORAGE_PROVIDER=mongodb_gridfs, storing
# resume file bytes via GridFS (bucket "resumes"). Never used for
# candidate/application/organization data, which stays in Postgres.
# Required if RESUME_STORAGE_PROVIDER=mongodb_gridfs; leave both unset for
# local "local"-provider development. Get a connection string from MongoDB
# Atlas (or any MongoDB deployment) — never commit the real value.
MONGODB_URI=
MONGODB_DATABASE=ai_recruitment

# Optional: outbound email over SMTP — for LOCAL DEVELOPMENT (manual interview/selection emails,
# application confirmations, assessment invitations). Without these the app
# runs fully — sends fail with a clear "email not configured" error rather
# than being faked. Put the real SMTP_PASSWORD in your own local .env only;
# never commit it. (For Gmail, use an app password.)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=AI Recruitment Platform
SMTP_USE_TLS=true

# Production email over HTTPS (https://resend.com). Render's free web services
# block outbound SMTP ports, so set these on the host instead of SMTP_*. When
# both are set, Resend is used in preference to SMTP; leave them empty locally
# to keep using SMTP above. EMAIL_FROM must be on a domain verified in Resend,
# e.g. SIGVITAS <hr@yourdomain.com>. Never commit a real RESEND_API_KEY.
RESEND_API_KEY=
EMAIL_FROM=

# Optional: AI-assisted resume screening. Without any of these set,
# screening returns a clear "provider not configured" error rather than a
# fabricated result. Prefer the free/local Ollama option below — set
# ONLY ONE of the three; Ollama wins if set, then Anthropic, then OpenAI.

# Free, local, no API key — install Ollama (https://ollama.com), run
# `ollama pull llama3.1` (or another model), then set this to its URL.
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.1

# Paid, cloud-hosted alternatives — only needed if you don't want to run
# Ollama locally.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
