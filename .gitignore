# Environment / secrets
.env
.env.*
!.env.example

# Python
backend/.venv/
backend/**/__pycache__/
*.pyc
backend/.pytest_cache/
backend/.mypy_cache/
backend/.ruff_cache/
backend/htmlcov/
backend/.coverage
backend/*.egg-info/

# Node / frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/coverage/

# Uploaded files (local storage backend — never committed)
backend/uploads/

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Alembic (keep migration scripts, ignore local sqlite/dev artifacts if any)
backend/*.db

# Data-migration dumps/backups (local <-> Render) — contain real password
# hashes/PII, never committed. See docs/deployment.md if a repeatable
# migration script is added later.
backend/*.dump
backend/local_data_only_*.sql
