# Local dev: the backend's local address. Production (Vercel): the deployed
# Render backend's URL, e.g. https://sigvitas-recruitment-api.onrender.com
# Never put backend secrets in VITE_* variables — everything prefixed
# VITE_ is bundled into the client-side JS and is publicly readable.
VITE_API_BASE_URL=http://localhost:8000
